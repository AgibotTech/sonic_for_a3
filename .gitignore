# Keep the small A3 actuator-model lookup tables versioned.  The generic
# Python-template data/ rule above otherwise hides this package asset.
!gear_sonic/data/
gear_sonic/data/*
!gear_sonic/data/a3_motor_model/
!gear_sonic/data/a3_motor_model/**

# The minimal PICO sender is intentionally torch-free on the target.  Keep its
